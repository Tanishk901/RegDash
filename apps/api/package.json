{
  "name": "@regdash/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "sample:excel": "tsx scripts/make-sample-excel.ts"
  },
  "dependencies": {
    "@regdash/shared": "workspace:*",
    "cors": "^2.8.5",
