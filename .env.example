# Copy to apps/api/.env and fill in. Never commit the real .env.

# Which data source the API reads from: mock | excel | servicenow
DATA_SOURCE=mock

PORT=4000
# How often the API re-pulls data from the source (seconds)
REFRESH_INTERVAL_SECONDS=300

# ---- excel source ----
# Path to a local copy / synced copy of the SharePoint workbook
EXCEL_PATH=../../data/sample-tickets.xlsx
EXCEL_SHEET=Tickets
# A bare number in the time-per-task column means: hours | minutes
# ("30 min", "2h", "1d 4h" and h:mm are always understood)
EXCEL_TIME_UNIT=hours

# ---- servicenow source ----
# e.g. https://yourinstance.service-now.com
SERVICENOW_BASE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Only pull tickets for this assignment group (display name)
SERVICENOW_ASSIGNMENT_GROUP=RegCreate Support
