{
  "name": "regdash",
  "version": "0.1.0",
  "private": true,
  "description": "RegDash — RegCreate Operations Dashboard (Phase 1: incident & SR visibility)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @regdash/api --filter @regdash/web dev",
    "dev:api": "pnpm --filter @regdash/api dev",
    "dev:web": "pnpm --filter @regdash/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "sample:excel": "pnpm --filter @regdash/api sample:excel"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
